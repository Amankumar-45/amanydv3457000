# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/intelli_credit
MONGODB_URI=mongodb://localhost:27017/intelli_credit

# API Configuration
API_PORT=5000
API_HOST=0.0.0.0
NODE_ENV=development
DEBUG=True

# Security
SECRET_KEY=your_secret_key_here
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRATION=86400

# Machine Learning Models
MODEL_PATH=./data/models/
SCALER_PATH=./data/models/scaler.pkl
ENSEMBLE_MODEL=xgboost

# Fraud Detection
FRAUD_DETECTION_ENABLED=True
FRAUD_THRESHOLD=0.7

# Risk Assessment
RISK_ASSESSMENT_MODEL=ensemble
RISK_SCORING_THRESHOLD=0.5

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_app_password

# AWS Configuration (if using S3)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=your_bucket_name
AWS_REGION=us-east-1

# Third-party APIs
CREDIT_BUREAU_API_KEY=your_api_key
VERIFICATION_API_URL=https://api.verification-service.com

# Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Reporting
REPORT_GENERATION_ENABLED=True
REPORT_FORMAT=pdf